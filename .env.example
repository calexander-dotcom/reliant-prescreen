# car_watch.py — environment variables
# Copy this file to ".env" on the server, fill in the real values, and make
# sure your cron line sources it (see README "Run it hourly with cron").
# The .env file is git-ignored so secrets never get committed.

# --- Required ---------------------------------------------------------------
# Car-listings data source (https://www.marketcheck.com/automotive/apis)
MARKETCHECK_API_KEY=

# Email sending (https://sendgrid.com/ → Settings → API Keys, Mail Send scope)
SENDGRID_API_KEY=

# --- Optional: text-message alerts (Twilio) ---------------------------------
# Leave SMS_TO_NUMBERS empty to keep texting off. Numbers in E.164 format
# (e.g. +18135551234); SMS_TO_NUMBERS is a comma-separated list.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBERS=
