# Twilio account credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number (E.164) that sends/receives screening SMS
TWILIO_FROM_NUMBER=+15555550100

# Public base URL Twilio uses to reach this service, e.g. https://prescreen.example.com
# Used to validate the X-Twilio-Signature on inbound webhooks.
PUBLIC_BASE_URL=http://localhost:3000

# Set to "false" to skip Twilio request signature validation (local dev only).
VALIDATE_TWILIO_SIGNATURE=true

# HTTP port the server listens on
PORT=3000
