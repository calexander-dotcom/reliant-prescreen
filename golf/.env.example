# All optional. The app runs with none of these set.

# Base URL for the (unofficial, undocumented) GHIN API.
# Override if the endpoints move.
# GHIN_API_BASE=https://api2.ghin.com/api/v1

# The "source" query parameter GHIN's own clients send.
# GHIN_SOURCE=GHINcom

# Set to 1 to enable GET /api/ghin/raw?path=... , which returns GHIN's
# unmodified JSON. Use it to fix field mappings when an import comes back
# empty. Leave it off in anything you deploy publicly.
# GHIN_ALLOW_RAW=1
